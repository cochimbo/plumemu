msgstr "Codes %s de %s. Ils sont gardés pour ce jeu et activés à son ouverture."

msgid ""
"Deja tus .sf2 en la carpeta de SoundFonts\n"
"y aparecerán aquí."
msgstr ""
"Mettez vos .sf2 dans le dossier des SoundFonts\n"
"et ils apparaîtront ici."

