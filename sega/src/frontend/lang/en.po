msgid "Códigos Game Genie (3A8-6CF-E66) o Action Replay (00C0-1205) de %s. Se guardan para este juego y se activan al abrirlo."
msgstr "Game Genie (3A8-6CF-E66) or Action Replay (00C0-1205) codes for %s. They are saved for this game and turned on when it opens."

msgid "Códigos Game Genie (ABCD-EFGH) o Action Replay (FF0A12:0009) de %s. Se guardan para este juego y se activan al abrirlo."
msgstr "Game Genie (ABCD-EFGH) or Action Replay (FF0A12:0009) codes for %s. They are saved for this game and turned on when it opens."

msgid ""
"Deja tus .sf2 en la carpeta de SoundFonts\n"
"y aparecerán aquí."
msgstr ""
"Put your .sf2 files in the SoundFonts folder\n"
"and they will show up here."

